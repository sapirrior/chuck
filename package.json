{
  "name": "steward",
  "version": "0.5.1",
  "description": "Engineering agent for codebase investigation, direct file mutation, and guaranteed rewind checkpointing.",
  "author": "sapirrior",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "steward": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "prepublishOnly": "bun run build",
    "build": "bun build src/cli.ts --outdir ./dist --target node",
    "compile": "bun build --compile --minify src/cli.ts --outfile ./dist/steward",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "format:fix": "bun ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "lint:boundaries": "bun test tests/tui/boundary-lint.test.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.52",
    "@ai-sdk/deepseek": "3.0.44",
    "@ai-sdk/google": "4.0.67",
    "@ai-sdk/mistral": "4.0.43",
    "@ai-sdk/openai": "4.0.65",
    "@ai-sdk/openai-compatible": "3.0.47",
    "@ai-sdk/xai": "4.0.58",
    "ai": "7.0.97",
    "chalk": "6.0.0",
    "cli-highlight": "2.1.11",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.12",
    "string-width": "8.2.2",
    "strip-ansi": "7.2.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.6"
  }
}
